GENESIS_ENV=development
GENESIS_DATABASE_URL=sqlite:///./genesis_business_os.db
GENESIS_JWT_SECRET=replace-with-at-least-32-random-characters
GENESIS_ALLOWED_ORIGINS=http://localhost:3000
GENESIS_ALLOWED_HOSTS=localhost,127.0.0.1
GENESIS_COOKIE_SECURE=false

# Real execution providers — leave unset until the owner connects the account.
GENESIS_SENDGRID_API_KEY=
GENESIS_SENDGRID_FROM_EMAIL=
GENESIS_SQUARE_ACCESS_TOKEN=
GENESIS_SQUARE_LOCATION_ID=
