modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Genesis Business OS"

[[workflows.workflow]]
name = "Genesis Business OS"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd genesis-business-os/backend && GENESIS_ALLOWED_HOSTS=\"localhost,127.0.0.1,testserver,${REPLIT_DEV_DOMAIN:-}\" uvicorn app.main:app --host 0.0.0.0 --port 8000"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["libxcrypt", "postgresql"]
